# Waypoint Configuration

# User ID for the current session (required for MCP server)
WAYPOINT_USER_ID=

# Database file path (optional, defaults to ./waypoint.db)
WAYPOINT_DB_PATH=./waypoint.db

# Web UI Configuration
WAYPOINT_WEB_ENABLED=true
WAYPOINT_WEB_PORT=3000
WAYPOINT_SESSION_SECRET=change-me-in-production
