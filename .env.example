# Waypoint Configuration

# First run only: creates the initial admin (and a root organization) when the database has no users.
WAYPOINT_ADMIN_EMAIL=
WAYPOINT_ADMIN_NAME=Administrator
WAYPOINT_ORG_NAME=My Organization

# User ID the MCP server runs as (required for the MCP server; the admin id is printed on first run)
WAYPOINT_USER_ID=

# Database file path (optional, defaults to ./waypoint.db)
WAYPOINT_DB_PATH=./waypoint.db

# Web UI
WAYPOINT_WEB_ENABLED=true
# Loopback by default. Login is email-only, so only change this behind a trusted network or auth proxy.
WAYPOINT_WEB_HOST=127.0.0.1
WAYPOINT_WEB_PORT=3000
# Set to a long random string
WAYPOINT_SESSION_SECRET=change-me-in-production

# Set to false for a web-only deployment (the MCP server is stdio and needs a client attached)
WAYPOINT_MCP_ENABLED=true
