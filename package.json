{
  "name": "waypoint",
  "version": "0.1.0",
  "description": "MCP server that provides organizational goal context to AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "init": "node scripts/init.js",
    "seed": "node scripts/seed.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "export": "node scripts/export.js",
    "export:skill": "node scripts/export-skill.js",
    "import": "node scripts/import.js"
  },
  "keywords": [
    "mcp",
    "goals",
    "organization",
    "ai"
  ],
  "license": "MIT",
  "author": "zafrem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zafrem/Waypoint.git"
  },
  "homepage": "https://github.com/zafrem/Waypoint#readme",
  "bugs": {
    "url": "https://github.com/zafrem/Waypoint/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/formbody": "^8.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/view": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.4.1",
    "ejs": "^3.1.10",
    "fastify": "^5.0.0",
    "uuid": "^10.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0"
  }
}
