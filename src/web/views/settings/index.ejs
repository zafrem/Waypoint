<%- include('../layouts/main', { body: `
<div class="page-header">
  <h1>App Settings</h1>
  <p class="page-subtitle">Configure application-wide settings</p>
</div>

<div class="card">
  <div class="card-header">
    <h2>Server Configuration</h2>
  </div>
  <div class="card-body">
    <dl class="config-list">
      <div class="config-item">
        <dt>Database Path</dt>
        <dd><code>${config.dbPath}</code></dd>
      </div>
      <div class="config-item">
        <dt>Web Port</dt>
        <dd><code>${config.webPort}</code></dd>
      </div>
      <div class="config-item">
        <dt>Web UI Status</dt>
        <dd><span class="badge badge-success">Enabled</span></dd>
      </div>
    </dl>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>Custom Settings</h2>
  </div>
  <div class="card-body">
    ${settings.length === 0 ? '<p class="text-muted">No custom settings configured.</p>' : `
    <table class="table">
      <thead>
        <tr>
          <th>Key</th>
          <th>Value</th>
          <th>Type</th>
          <th>Description</th>
          ${user && user.isAdmin ? '<th>Actions</th>' : ''}
        </tr>
      </thead>
      <tbody>
        ${settings.map(setting => `
        <tr>
          <td><code>${esc(setting.key)}</code></td>
          <td><code>${esc(setting.value)}</code></td>
          <td><span class="badge">${esc(setting.type)}</span></td>
          <td>${esc(setting.description || '-')}</td>
          ${user && user.isAdmin ? `<td>
            <form action="/settings/delete" method="POST" style="display: inline;">
              <input type="hidden" name="key" value="${esc(setting.key)}">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>` : ''}
        </tr>
        `).join('')}
      </tbody>
    </table>
    `}
  </div>
</div>

${user && user.isAdmin ? `
<div class="card">
  <div class="card-header">
    <h2>Save &amp; Share Data</h2>
  </div>
  <div class="card-body">
    <p>Download everything (organizations, users, goals, plans, standards, roles) as one JSON file to back it up or share it with another Waypoint instance.</p>
    <p><a href="/settings/export" class="btn btn-primary">Export Data (JSON)</a></p>
    <hr>
    <p><strong>Import</strong> replaces <em>all</em> current data and signs everyone out. The file must contain an admin user.</p>
    <input type="file" id="import-file" accept="application/json,.json">
    <button type="button" class="btn btn-danger" id="import-btn">Import Data</button>
    <p id="import-msg" class="text-muted"></p>
  </div>
</div>
<script>
document.getElementById('import-btn').addEventListener('click', async () => {
  const file = document.getElementById('import-file').files[0];
  const msg = document.getElementById('import-msg');
  if (!file) { msg.textContent = 'Choose a file first.'; return; }
  if (!confirm('This replaces ALL existing data. Continue?')) return;
  try {
    const res = await fetch('/settings/import', { method: 'POST', headers: { 'content-type': 'application/json' }, body: await file.text() });
    const out = await res.json().catch(() => ({}));
    if (!res.ok) { msg.textContent = 'Import failed: ' + (out.error || res.status); return; }
    window.location.href = '/auth/login';
  } catch (e) { msg.textContent = 'Import failed: ' + e.message; }
});
</script>
` : ''}

${user && user.isAdmin ? `
<div class="card">
  <div class="card-header">
    <h2>Add New Setting</h2>
  </div>
  <div class="card-body">
    <form action="/settings" method="POST" class="form">
      <div class="form-row">
        <div class="form-group">
          <label for="key">Key</label>
          <input type="text" id="key" name="key" required placeholder="setting_key">
        </div>
        <div class="form-group">
          <label for="value">Value</label>
          <input type="text" id="value" name="value" required placeholder="setting_value">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="type">Type</label>
          <select id="type" name="type">
            <option value="string">String</option>
            <option value="number">Number</option>
            <option value="boolean">Boolean</option>
            <option value="json">JSON</option>
          </select>
        </div>
        <div class="form-group">
          <label for="description">Description (optional)</label>
          <input type="text" id="description" name="description" placeholder="Description of this setting">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Add Setting</button>
    </form>
  </div>
</div>
` : ''}
` }) %>
